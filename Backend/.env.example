# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

MONGO_URI=replace_with_your_mongodb_connection_uri
MONGO_DB=ota_db_jessy_new

HEX_STORAGE_ACCOUNT_NAME=replace_with_storage_account_name
HEX_STORAGE_CONTAINER_NAME=hexfiles
HEX_STORAGE_ACCOUNT_KEY=replace_with_storage_account_key

IOTHUB_CONNECTION_STRING=replace_with_iot_hub_connection_string
SERVICE_BUS_CONNECTION=replace_with_service_bus_connection_string

INTERNAL_SECRET=replace_with_a_long_random_secret
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Path to a private key stored locally; do not commit the key.
PRIVATE_KEY_PATH=/app/private.pem
